{
  "expo": {
    "name": "ResetPulse",
    "slug": "resetPulse",
    "version": "3.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F5F0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.irimwebforge.resetpulse",
      "buildNumber": "29",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      },
      "appleTeamId": "X22C5XKG29"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4A5568",
          "sounds": [
            "./assets/sounds/aj_heels__timercomplete01.wav",
            "./assets/sounds/theplax__microwave_ping.wav",
            "./assets/sounds/inoshirodesign__singing_bowl_strike.wav",
            "./assets/sounds/sgossner__contrabass_pizzicato_c2.wav",
            "./assets/sounds/azumarill__toaster_oven_or_liftelevator_bell.wav",
            "./assets/sounds/littlerobotsoundfactory__jingle_achievement.wav",
            "./assets/sounds/foochie_foochie__kalimba_c_note.wav",
            "./assets/sounds/jack_urbanski__vibraphone_chord.wav",
            "./assets/sounds/joesh2__marimba_c3.wav",
            "./assets/sounds/pogmothoin__marimba_ascending.wav",
            "./assets/sounds/foolboymedia__up_chime_2.wav",
            "./assets/sounds/grunz__success.wav"
          ]
        }
      ],
      "expo-localization",
      "expo-asset",
      "expo-audio",
      "@bacons/apple-targets",
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36,
            "compileSdkVersion": 36
          }
        }
      ]
    ],
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#4A5568",
      "androidMode": "default",
      "androidCollapsedTitle": "ResetPulse"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E07B4F"
      },
      "package": "com.irimwebforge.resetpulse",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f98f80b8-4a15-4ece-afa5-5311174f67b8"
      },
      "revenueCat": {
        "iosKey": "appl_NJoSzWzcoJXLiNDMTGKJShISApt",
        "androidKey": "goog_URjPIqpNSxbyogfdststoCOmQRg"
      }
    }
  }
}